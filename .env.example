# Copie este archivo a .env.local y rellene los valores.
# .env.local está en .gitignore: nunca suba credenciales al repositorio.

# ── Sitio ─────────────────────────────────────────────────────────────────────
# Dominio canónico, sin barra final. Alimenta canonicals, sitemap, robots y OG.
# Si falta, se usa https://www.huntersolutions.tech (lib/seo.ts).
NEXT_PUBLIC_SITE_URL="https://www.huntersolutions.tech"

# ── Agentes y herramientas de IA ──────────────────────────────────────────────
# AGENT_MODEL (lib/agents/runtime.ts) usa un identificador de modelo del AI
# Gateway de Vercel ("openai/gpt-4o-mini"), que se autentica con esta clave.
# En despliegues de Vercel el OIDC del proyecto puede sustituirla.
# Sin ella, /api/agents/*, /api/herramientas/* responden 503 y el recomendador
# cae a su mapeo por reglas, que funciona sin LLM.
AI_GATEWAY_API_KEY=""

# ── Rate limiting compartido ──────────────────────────────────────────────────
# Los endpoints de LLM son públicos: sin un contador compartido, el límite vive
# en memoria de cada instancia serverless y no protege de nada. Sirve cualquiera
# de los dos pares (Upstash Redis o Vercel KV); si no hay ninguno, el límite
# degrada al contador local y se registra una advertencia en el arranque.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ── Leads (app/api/leads) ─────────────────────────────────────────────────────
# El lead se entrega por webhook al CRM y/o por correo con Resend. Si ninguno
# de los dos canales está configurado o ambos fallan, el endpoint responde 502
# y el formulario ofrece el correo y el WhatsApp como alternativa.

# Destino del lead en el CRM. Opcional si se usa solo el correo.
LEADS_WEBHOOK_URL=""

# Resend: clave de API y destinatarios (uno o varios separados por coma).
RESEND_API_KEY=""
LEADS_TO_EMAIL="comercial@huntersolutions.tech"

# Remitente. Solo se respeta si la dirección termina en el subdominio verificado
# en Resend (@contacto.huntersolutions.tech); si no, se usa el remitente por
# defecto para evitar el 403 de dominio no verificado.
LEADS_FROM_EMAIL="HST Diagnóstico <diagnostico@contacto.huntersolutions.tech>"
